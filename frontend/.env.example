# API Base URL
# Development: http://localhost:8000
# Production / Docker Compose (Nginx reverse proxy): leave empty for relative URL
VITE_API_URL=

# Chế độ Mock dữ liệu độc lập (không cần backend)
# Set "true" để chạy frontend độc lập dùng dữ liệu demo từ mock/data.ts
# Set "false" hoặc để trống để kết nối FastAPI Backend
VITE_USE_MOCK_DATA=false
